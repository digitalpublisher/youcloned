 # cheap snapshot, so stop latency is bounded by one chunk (~85ms at 4096 B PCM
 # @ 24kHz) -- well under the ~200ms barge-in target.
 CONTROL_POLL_INTERVAL = 0.05
+
+
+class _InstantStopWatcher:
+    """2026-10-16 instant stop: polls the control state every 50 ms while a line plays, so a stop or
+    skip_forward ends playback at once even when the loop is blocked in stream.write() or waiting for
+    a slow first chunk. It aborts the device and records which key fired (it no longer cancels the task, 2026-10-16 pm)."""
+
+    def __init__(self, abort_fn):
+        self._abort = abort_fn
+        self._done = threading.Event()
+        self._lock = threading.Lock()
+        self.kind = None
+
+    def start(self):
+        self._loop = asyncio.get_running_loop()
+        self._task = asyncio.current_task()
+        self._thread = threading.Thread(target=self._run, daemon=True, name="instant-stop-watcher")
+        self._thread.start()
+
+    def _run(self):
+        while not self._done.wait(0.05):
+            try:
+                snap = get_control_state().snapshot()
+            except Exception:
+                continue
+            if snap.is_stopped or snap.is_skip_forward:
+                with self._lock:
+                    if self._done.is_set():
+                        return
+                    self.kind = "stop" if snap.is_stopped else "skip"
+                try:
+                    self._abort()
+                except Exception:
+                    logger.debug("instant stop abort failed", exc_info=True)
+                # 2026-10-16 pm: task.cancel() was removed. The watcher runs inside the converse tool's own task, so cancelling it
+                # killed the whole converse call (TOOL_CANCELLED client_cancel) and no listen opened after an Option interrupt.
+                # The device abort above unblocks stream.write(); the chunk loop then exits on snap.is_skip_forward/is_stopped
+                # and converse carries on to its listen.
+                logger.info("instant stop watcher fired: %s", self.kind)
+                return
+
+    def swallow(self, exc):
+        # a cancel we asked for must not leak out of the playback block
+        if isinstance(exc, asyncio.CancelledError):
+            try:
+                self._task.uncancel()
+            except Exception:
+                pass
 
+    def stop(self):
+        with self._lock:
+            self._done.set()
 
+
